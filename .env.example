# --- SAM.gov ---
SAM_API_KEY=your_sam_gov_api_key            # From SAM.gov > Account Details > API Key

# --- Database (Supabase > Project Settings > Database > Connection string, use the pooler URI) ---
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# --- Email (Resend: https://resend.com) ---
RESEND_API_KEY=re_xxxxxxxx
DIGEST_FROM="Fedintel <digest@yourdomain.com>"
DIGEST_TO=you@yourdomain.com

# --- Pipeline tuning ---
LOOKBACK_DAYS=2            # How many days back to pull on each run
MIN_DIGEST_SCORE=40        # Opportunities below this score are stored but not emailed
TIMEZONE=America/Chicago

# --- Optional: signed action links in the digest (Track / Good match / ...) ---
# Leave blank to disable; the digest renders View-only links and cron still works.
ACTION_BASE_URL=
ACTION_SECRET=

# --- Company profile for personalized scoring ---
COMPANY_PROFILE_PATH=company_profile.json
INGEST_BATCH_SIZE=50
